{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "permission": {
    "external_directory": {
      "/tmp/*": "allow"
    },
    "bash": "allow"
  },
  "references": {
    "db-schema": {
      "path": "../db-schema",
      "description": "Schema de base de datos, tablas, columnas y referencias a crear, esto no esta creado es solo una referencia a la BD"
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true
    },
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp@latest"],
      "enabled": true
    }
  }
}
